---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutScene from "../components/AboutScene";
---
<BaseLayout title="About | Lynn Han">
  <section class="relative max-w-5xl space-y-8">
    <div class="hero-control-label hidden md:flex">
      <span class="font-mono text-sm">$ whoami --verbose</span>
    </div>
    <div class="font-mono text-sm md:hidden">$ whoami --verbose</div>
    <h1 class="text-4xl font-bold">Engineer, Designer and Builder</h1>
    <p class="max-w-3xl text-lg text-black/80">
      I build data-intensive products, visualization systems, and AI-assisted workflows
      that turn complex operational data into usable product experiences.
    </p>
  </section>

  <section class="mt-16 space-y-6">
    <div class="font-mono text-sm">$ ./skills-map --interactive</div>
    <div class="mt-8">
      <AboutScene client:load />
    </div>
  </section>
</BaseLayout>
