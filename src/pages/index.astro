---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalPanel from "../components/TerminalPanel.astro";
import ProjectFilter from "../components/ProjectFilter";
import { sortProjects } from "../lib/projectOrder";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const projectData = sortProjects(projects)
  .map((entry) => ({
  slug: entry.slug,
  ...entry.data,
}));
---
<BaseLayout title="Lynn Han | Portfolio">
  <section class="relative bg-blob bg-blob--lower">
    <div class="hero-control-label hidden md:flex">
      <span class="hero-kicker font-mono text-sm">$ whoami</span>
    </div>
    <div class="relative z-10 mt-8 grid gap-10 md:mt-8 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-5">
        <div class="hero-kicker font-mono text-sm md:hidden">$ whoami</div>
        <h1 class="text-4xl font-bold uppercase tracking-tight sm:text-5xl">
          Lynn Han
        </h1>
        <p class="max-w-xl text-lg text-black/80">
          Product-focused software engineer with 6+ years of experience building data-intensive
          applications and intuitive user experiences. Combines strong frontend engineering and product
          design instincts with hands-on work in data preprocessing, analytics, and ML/LLM-powered
          workflows to turn complex data into useful products.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a class="pill border-black bg-black text-white" href="#projects">cd ~/projects</a>
          <a class="pill border-black" href="https://www.linkedin.com/in/guojun-lynn-han-082066173/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="pill border-black" href="https://github.com/Lynnhan95" target="_blank" rel="noreferrer">GitHub</a>
          <a class="pill border-black" href="mailto:lynnhan1995@gmail.com">Email</a>
        </div>
      </div>
      <TerminalPanel
        lines={[
          "$ whoami\nRole: Senior Software Engineer\nFocus: Data Visualization, Full-Stack Engineering, Data-Intensive Products, Statistics, and exploring LLMs\nLocation: USA",
        ]}
      />
    </div>
  </section>

  <section id="projects" class="mt-20 space-y-8">
    <div class="space-y-2">
      <div class="font-mono text-sm">$ ls ~/projects</div>
      <h2 class="text-3xl font-semibold">Selected Work</h2>
    </div>
    <div class="mt-6">
      <ProjectFilter client:load projects={projectData} />
    </div>
  </section>

</BaseLayout>
