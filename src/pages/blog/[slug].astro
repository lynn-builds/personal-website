---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const baseUrl = import.meta.env.BASE_URL;
const tagLabels = {
  astro: "Astro",
  design: "Design",
  frontend: "Frontend",
  react: "React",
};
const toDisplayLabel = (value) =>
  tagLabels[value] ?? value.replace(/(^|\s|-)\S/g, (match) => match.toUpperCase());
---
<BaseLayout title={`${post.data.title} | Blog`}>
  <article class="max-w-4xl space-y-12">
    <section class="relative space-y-6">
      <div class="hero-control-label hidden md:flex">
        <span class="font-mono text-sm">$ cat ~/blog/{post.slug}</span>
      </div>
      <div class="font-mono text-sm md:hidden">$ cat ~/blog/{post.slug}</div>
      <a
        class="pill border-black text-sm font-mono"
        href={`${baseUrl}blog`}
        onclick="if (history.length > 1) { history.back(); return false; }"
      >
        cd .. (go back)
      </a>
      <header class="space-y-4">
        <h1 class="text-4xl font-bold">{post.data.title}</h1>
        <p class="text-lg text-black/80">{post.data.description}</p>
        <div class="flex flex-wrap items-center gap-3 text-sm font-mono uppercase tracking-wide">
          <span>{post.data.date}</span>
          {post.data.tags?.map((tag) => (
            <span class="pill border-black" key={tag}>{toDisplayLabel(tag)}</span>
          ))}
        </div>
        {post.data.mediumUrl && (
          <div class="space-y-2 pt-1">
            <div class="font-mono text-xs uppercase tracking-wide text-black/80">Links</div>
            <div class="flex flex-wrap items-center gap-4 text-sm font-mono">
              <a
                class="underline decoration-2 underline-offset-4 hover:opacity-70"
                href={post.data.mediumUrl}
                target="_blank"
                rel="noreferrer"
              >
                Open Medium
              </a>
            </div>
          </div>
        )}
      </header>
    </section>

    <section class="space-y-6">
      <div class="rich-content">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>
